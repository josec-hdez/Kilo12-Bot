# Token del bot (lo entrega @BotFather)
TELEGRAM_TOKEN=
# IDs de Telegram de las dueñas, separados por coma
OWNER_IDS=
# Clave de la API de Anthropic (opcional en el MVP; la usan las preguntas libres)
ANTHROPIC_API_KEY=
# JSON completo de la service account de Google, o ruta a un archivo .json.
# Si se deja vacío, el bot trabaja con una hoja simulada en memoria y lo avisa.
GOOGLE_SA_JSON=
# Carpeta de Drive donde llegan los IPV (opcional por ahora)
DRIVE_IPV_FOLDER_ID=
# Hoja de cuadre "Cuadre K12 Remoto" (opcional por ahora)
CUADRE_SHEET_ID=
# Ruta de la base de datos SQLite
DB_PATH=./data/kilo12.db
TZ=America/Havana

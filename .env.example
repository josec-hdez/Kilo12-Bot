# Token del bot (lo entrega @BotFather)
TELEGRAM_TOKEN=
# IDs de Telegram de las dueñas, separados por coma
OWNER_IDS=
# Clave de la API de Anthropic (opcional; el MVP no usa IA)
ANTHROPIC_API_KEY=
# JSON completo de la service account de Google, o ruta a un archivo .json.
# Si se deja vacío, el bot trabaja con una hoja simulada en memoria y lo avisa.
GOOGLE_SA_JSON=
# Carpeta de Drive donde llegan los IPV (opcional por ahora)
DRIVE_IPV_FOLDER_ID=
# Hoja de cuadre "Cuadre K12 Remoto" (opcional por ahora)
CUADRE_SHEET_ID=
# Cuadre exportado (.xlsx) para cargar el catálogo y los costos la primera vez
# (solo si la base está vacía; usa la última pestaña de días).
CUADRE_SEED_PATH=
# Hoja "Gastos": historial donde /gasto agrega una fila por gasto (Fecha, Cantidad,
# Moneda, Descripcion). Compártela con la service account como Editor. Si se deja
# vacío, /gasto guarda en memoria (se pierde al reiniciar) y el bot lo avisa.
GASTOS_SPREADSHEET_ID=
# Ruta de la base de datos SQLite
DB_PATH=./data/kilo12.db
TZ=America/Havana
